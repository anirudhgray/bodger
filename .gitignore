# Ephemeral session notes (see CLAUDE.md)
agents/design-docs

# Build artefacts
bin/
/dist/
coverage.out
web/node_modules/

# Vite's build output (web/vite.config.ts's build.outDir): embedded by
# internal/platform/webui via go:embed. Nothing `npm run build` produces
# here is tracked — its placeholder fallback page lives outside this
# directory entirely (internal/platform/webui/placeholder/), specifically
# so a real local build never dirties a tracked file. .gitkeep only
# exists so `//go:embed all:dist` has something to match on a fresh
# checkout that hasn't run `make build-web` yet.
internal/platform/webui/dist/*
!internal/platform/webui/dist/.gitkeep

# Agent-managed worktrees (git worktree add .claude/worktrees/...)
.claude/worktrees/

# Local runtime data
*.db
*.db-wal
*.db-shm
# Pre-migration safety backups (internal/adapters/sqlite/migrate.go's
# backupBeforeMigrate, ADR-0007): "<db file>.pre-<target version>.bak".
*.db.pre-*.bak
.env
.env.*

# curl's cookie jar (docs/user-guide.md and PR testing steps use
# `curl -c cookies.txt` against a locally running `bodger serve`)
cookies.txt

.DS_Store
