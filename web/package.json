{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "test": "vitest run && npm run check:api-types && npm run test:e2e",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "generate": "npm run generate:api-types",
    "generate:api-types": "openapi-typescript ../internal/surface/http/openapi.json -o src/lib/api-types.ts",
    "check:api-types": "openapi-typescript ../internal/surface/http/openapi.json -o src/lib/api-types.ts --check"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.39.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "7.13.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "shadcn": "^4.19.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-mkcert": "^2.1.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
