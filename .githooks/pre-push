#!/bin/bash
# .githooks/pre-push - deterministic, client-side guard against pushing
# to main directly. This project requires every change to main to go
# through a reviewed PR (see CLAUDE.md).
#
# This is a local safety net, not the enforcement mechanism: it's
# bypassable with `git push --no-verify` (or the ALLOW_MAIN_PUSH escape
# hatch below) and only guards whichever clone has it activated. A real
# GitHub branch protection rule is the unbypassable version of this -
# prefer that once it's available (e.g. once the repo is public, or on a
# paid plan); until then, this client-side pair of hooks is the
# available substitute.
#
# Complements - doesn't replace - the Claude Code PreToolUse hook at
# .claude/hooks/block-main-push.sh, which only fires on pushes Claude
# Code itself runs. This one fires for any git client: a plain terminal,
# another tool, anything.
#
# Not active by default - git doesn't read hooks from a tracked
# directory on its own. Run `make setup-hooks` once per clone (or
# `git config core.hooksPath .githooks` directly) to enable it.
#
# git feeds ref updates on stdin, one per line:
#   <local ref> SP <local sha1> SP <remote ref> SP <remote sha1> LF
# (see githooks(5)). $1/$2 (remote name/URL) are intentionally unused -
# this blocks a push to any remote's refs/heads/main, not just "origin".

if [ -n "$ALLOW_MAIN_PUSH" ]; then
  exit 0
fi

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    blocked=1
  fi
done

if [ "$blocked" = "1" ]; then
  echo "BLOCKED: direct push to main. This project requires all changes to main to go through a reviewed PR (see CLAUDE.md)." >&2
  echo "If this is genuinely intentional, rerun as 'ALLOW_MAIN_PUSH=1 git push ...', or 'git push --no-verify'." >&2
  exit 1
fi

exit 0
