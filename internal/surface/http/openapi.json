{
  "components": {
    "parameters": {
      "Id": {
        "description": "The resource's ID, or (for an account or category) its unique name.",
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "InvalidInput": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "description": "The request failed validation."
      },
      "NotFound": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "description": "No such resource."
      }
    },
    "schemas": {
      "Account": {
        "properties": {
          "archived": {
            "type": "boolean"
          },
          "archived_at": {
            "description": "Set only once the account is archived.",
            "format": "date",
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "institution": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "opening_balance": {
            "description": "A plain decimal amount. Always a JSON string, in the sibling currency field's currency - never a number.",
            "format": "money",
            "type": "string"
          },
          "opening_balance_date": {
            "description": "The date the opening balance is stated as of.",
            "format": "date",
            "type": "string"
          },
          "sort_order": {
            "description": "Where the account sorts in a list; lower comes first.",
            "type": "integer"
          },
          "type": {
            "enum": [
              "bank",
              "cash",
              "credit_card",
              "wallet",
              "investment",
              "loan",
              "other"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "currency",
          "opening_balance",
          "sort_order",
          "archived"
        ],
        "type": "object"
      },
      "AccountEnvelope": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Account"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "AccountListEnvelope": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Account"
            },
            "type": "array"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "Balance": {
        "properties": {
          "account": {
            "description": "The account's name.",
            "type": "string"
          },
          "account_id": {
            "type": "string"
          },
          "amount": {
            "description": "A plain decimal amount. Always a JSON string, in the sibling currency field's currency - never a number.",
            "format": "money",
            "type": "string"
          },
          "currency": {
            "type": "string"
          }
        },
        "required": [
          "account_id",
          "account",
          "amount",
          "currency"
        ],
        "type": "object"
      },
      "Balances": {
        "properties": {
          "as_of": {
            "description": "The date every balance below is computed as of.",
            "format": "date",
            "type": "string"
          },
          "balances": {
            "items": {
              "$ref": "#/components/schemas/Balance"
            },
            "type": "array"
          }
        },
        "required": [
          "as_of",
          "balances"
        ],
        "type": "object"
      },
      "BalancesEnvelope": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Balances"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "Category": {
        "properties": {
          "archived": {
            "type": "boolean"
          },
          "archived_at": {
            "description": "Set only once the category is archived.",
            "format": "date",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "parent_id": {
            "description": "Absent for a top-level category.",
            "type": "string"
          },
          "sort_order": {
            "description": "Where the category sorts in a list; lower comes first.",
            "type": "integer"
          },
          "type": {
            "enum": [
              "expense",
              "income"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "sort_order",
          "archived"
        ],
        "type": "object"
      },
      "CategoryEnvelope": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Category"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "CategoryListEnvelope": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Category"
            },
            "type": "array"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "CreateAccountRequest": {
        "properties": {
          "currency": {
            "type": "string"
          },
          "institution": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "opening_balance": {
            "description": "Defaults to zero.",
            "format": "money",
            "type": "string"
          },
          "opening_balance_date": {
            "description": "The date the opening balance is stated as of. Omit to state it as of today.",
            "format": "date",
            "type": "string"
          },
          "sort_order": {
            "description": "Where the account sorts in a list; lower comes first.",
            "type": "integer"
          },
          "type": {
            "enum": [
              "bank",
              "cash",
              "credit_card",
              "wallet",
              "investment",
              "loan",
              "other"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "type"
        ],
        "type": "object"
      },
      "CreateCategoryRequest": {
        "properties": {
          "name": {
            "type": "string"
          },
          "parent": {
            "description": "A parent category's ID or unique name. Omit for a top-level category.",
            "type": "string"
          },
          "sort_order": {
            "description": "Where the category sorts in a list; lower comes first.",
            "type": "integer"
          },
          "type": {
            "enum": [
              "expense",
              "income"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "type"
        ],
        "type": "object"
      },
      "CreateTransactionRequest": {
        "properties": {
          "account": {
            "description": "An account's ID or unique name.",
            "type": "string"
          },
          "amount": {
            "description": "Always positive; type says which way the money moves.",
            "format": "money",
            "type": "string"
          },
          "category": {
            "description": "A category's ID or unique name.",
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "date": {
            "description": "Omit to book the transaction to today in the account owner's own timezone.",
            "format": "date",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": {
            "enum": [
              "outflow",
              "inflow"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "account",
          "amount",
          "description"
        ],
        "type": "object"
      },
      "CreateTransferRequest": {
        "properties": {
          "amount": {
            "description": "Always positive, in the from-account's own currency.",
            "format": "money",
            "type": "string"
          },
          "date": {
            "description": "Omit to book the transfer to today in the account owner's own timezone.",
            "format": "date",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "from_account": {
            "description": "An account's ID or unique name: the account the money leaves.",
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "to_account": {
            "description": "An account's ID or unique name: the account the money arrives in.",
            "type": "string"
          }
        },
        "required": [
          "from_account",
          "to_account",
          "amount",
          "description"
        ],
        "type": "object"
      },
      "EditTransactionRequest": {
        "properties": {
          "account": {
            "description": "An account's ID or unique name. Read when editing an outflow or an inflow.",
            "type": "string"
          },
          "amount": {
            "description": "Always positive; the transaction's own type says which way the money moves.",
            "format": "money",
            "type": "string"
          },
          "category": {
            "description": "A category's ID or unique name. Read when editing an outflow or an inflow.",
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "date": {
            "description": "Omit to book the transaction to today in the account owner's own timezone.",
            "format": "date",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "from_account": {
            "description": "An account's ID or unique name. Read when editing a transfer.",
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "to_account": {
            "description": "An account's ID or unique name. Read when editing a transfer.",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "description"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "enum": [
              "conflict",
              "internal",
              "invalid_input",
              "not_allowed",
              "not_found",
              "precondition_failed",
              "unauthenticated",
              "unavailable"
            ],
            "type": "string"
          },
          "details": {
            "additionalProperties": {},
            "description": "Safe, structured extra context - candidate names, valid options.",
            "type": "object"
          },
          "field": {
            "description": "The request field or CLI flag this error attaches to, when there is one.",
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Healthz": {
        "properties": {
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "HealthzEnvelope": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Healthz"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "PatchAccountRequest": {
        "properties": {
          "name": {
            "description": "The account's new name.",
            "nullable": true,
            "type": "string"
          },
          "opening_balance": {
            "description": "The opening balance to re-declare.",
            "format": "money",
            "nullable": true,
            "type": "string"
          },
          "opening_balance_date": {
            "description": "The date the new opening balance is stated as of. Only read alongside opening_balance.",
            "format": "date",
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "PatchCategoryRequest": {
        "properties": {
          "name": {
            "description": "The category's new name.",
            "nullable": true,
            "type": "string"
          },
          "parent": {
            "description": "A parent category's ID or unique name. An empty string moves the category to the top level.",
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "Transaction": {
        "properties": {
          "account_id": {
            "description": "Set on an outflow or an inflow.",
            "type": "string"
          },
          "amount": {
            "description": "Always positive; the transaction's type says which way the money moved.",
            "format": "money",
            "type": "string"
          },
          "category_id": {
            "description": "Set on an outflow or an inflow that has a category.",
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "date": {
            "description": "The date the transaction is booked to.",
            "format": "date",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "from_account_id": {
            "description": "Set on a transfer: the account the money left.",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "to_account_id": {
            "description": "Set on a transfer: the account the money arrived in.",
            "type": "string"
          },
          "type": {
            "enum": [
              "outflow",
              "inflow",
              "transfer"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "date",
          "description",
          "amount",
          "currency"
        ],
        "type": "object"
      },
      "TransactionEnvelope": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Transaction"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "TransactionList": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Transaction"
            },
            "type": "array"
          },
          "next_cursor": {
            "description": "An opaque token for the next page. Present only when there is a next page; its encoding isn't part of the API's contract and may change.",
            "type": "string"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "TransactionListEnvelope": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/TransactionList"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "bodger's read/write REST API. This is the web UI's only interface (milestone 2 generates its TypeScript client from this description) and is available to external clients and integrations. There is no authentication yet: the server binds a loopback address only, and refuses to start otherwise. Monetary values are always JSON strings, never numbers.",
    "title": "bodger REST API",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/v1/accounts": {
      "get": {
        "operationId": "listAccounts",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountListEnvelope"
                }
              }
            },
            "description": "Every account, in name order."
          }
        },
        "summary": "List every account."
      },
      "post": {
        "operationId": "createAccount",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAccountRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountEnvelope"
                }
              }
            },
            "description": "The created account."
          },
          "422": {
            "$ref": "#/components/responses/InvalidInput"
          }
        },
        "summary": "Create an account."
      }
    },
    "/api/v1/accounts/{id}": {
      "delete": {
        "description": "This hides the account from pickers; its history remains. There is no hard delete for an account with any history.",
        "operationId": "archiveAccount",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountEnvelope"
                }
              }
            },
            "description": "The archived account."
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "summary": "Archive an account."
      },
      "get": {
        "operationId": "getAccount",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountEnvelope"
                }
              }
            },
            "description": "The account."
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "summary": "Fetch one account by ID or unique name."
      },
      "patch": {
        "description": "The request body must set exactly one of \"name\" or \"opening_balance\" - these are two separate operations at the application layer, and a request naming both or neither is rejected.",
        "operationId": "patchAccount",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchAccountRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountEnvelope"
                }
              }
            },
            "description": "The updated account."
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/InvalidInput"
          }
        },
        "summary": "Rename an account, or re-declare its opening balance."
      }
    },
    "/api/v1/balances": {
      "get": {
        "operationId": "getBalances",
        "parameters": [
          {
            "description": "Defaults to today in the actor's own timezone when omitted.",
            "in": "query",
            "name": "as_of",
            "schema": {
              "format": "date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BalancesEnvelope"
                }
              }
            },
            "description": "Every account's balance as of the resolved date."
          }
        },
        "summary": "Every account's balance as of a date."
      }
    },
    "/api/v1/categories": {
      "get": {
        "operationId": "listCategories",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryListEnvelope"
                }
              }
            },
            "description": "Every category."
          }
        },
        "summary": "List every category, flat."
      },
      "post": {
        "operationId": "createCategory",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCategoryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryEnvelope"
                }
              }
            },
            "description": "The created category."
          },
          "422": {
            "$ref": "#/components/responses/InvalidInput"
          }
        },
        "summary": "Create a category."
      }
    },
    "/api/v1/categories/{id}": {
      "delete": {
        "description": "This hides the category from pickers; transactions that already reference it remain valid.",
        "operationId": "archiveCategory",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryEnvelope"
                }
              }
            },
            "description": "The archived category."
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "summary": "Archive a category."
      },
      "get": {
        "operationId": "getCategory",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryEnvelope"
                }
              }
            },
            "description": "The category."
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "summary": "Fetch one category by ID or unique name."
      },
      "patch": {
        "description": "The request body must set exactly one of \"name\" or \"parent\" (an empty \"parent\" moves the category to top-level) - these are two separate operations at the application layer, and a request naming both or neither is rejected.",
        "operationId": "patchCategory",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchCategoryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryEnvelope"
                }
              }
            },
            "description": "The updated category."
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/InvalidInput"
          }
        },
        "summary": "Rename a category, or move it to a new parent."
      }
    },
    "/api/v1/transactions": {
      "get": {
        "operationId": "listTransactions",
        "parameters": [
          {
            "description": "An account's ID or unique name.",
            "in": "query",
            "name": "account",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "A category's ID or unique name; its whole subtree is included.",
            "in": "query",
            "name": "category",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "One of \"outflow\", \"inflow\", or \"transfer\".",
            "in": "query",
            "name": "type",
            "schema": {
              "enum": [
                "outflow",
                "inflow",
                "transfer"
              ],
              "type": "string"
            }
          },
          {
            "description": "The inclusive start of a booked-date range.",
            "in": "query",
            "name": "from",
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "description": "The inclusive end of a booked-date range.",
            "in": "query",
            "name": "to",
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
